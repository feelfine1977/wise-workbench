# Copy to .env. Never commit .env.
WISE_VERSION=latest
WISE_MODE=single                # single | team
WISE_WORKSPACE=/workspace
WISE_DATABASE_URL=sqlite:////workspace/workbench.db
# team: WISE_DATABASE_URL=postgresql+psycopg://wise@postgres/wise  (password from secret)
WISE_LLM_BASE_URL=http://host.docker.internal:11434   # team on Linux: http://ollama:11434
WISE_LLM_MODEL=qwen3:8b
WISE_EMBED_MODEL=bge-m3
WISE_WORKERS=2
WISE_WORKER_MEMORY_LIMIT=8g
WISE_AUTH=token                 # token | oidc
WISE_OIDC_ISSUER=
WISE_OIDC_CLIENT_ID=
WISE_SECRET_KEY=change-me       # api refuses to start in team mode with this value
WISE_MAX_UPLOAD_MB=2048
WISE_LOG_FORMAT=json
