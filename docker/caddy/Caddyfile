# Draft. Replace the site address and the OIDC forward_auth target for your IdP.
wise.example.org {
    encode zstd gzip
    forward_auth oauth2-proxy:4180 {
        uri /oauth2/auth
        copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups
    }
    reverse_proxy api:8000 {
        flush_interval -1   # SSE
    }
}
