{
  "$schema": "./tokens.schema.json",
  "name": "wise-workbench",
  "version": "0.1.0",
  "spacing": {
    "unit": 4,
    "scale": { "0": 0, "px": 1, "0.5": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 }
  },
  "density": {
    "comfortable": { "rowHeight": 36, "controlHeight": 32, "cellPaddingX": 12 },
    "compact": { "rowHeight": 28, "controlHeight": 28, "cellPaddingX": 8 }
  },
  "typography": {
    "family": {
      "ui": "\"Inter\", \"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "mono": "\"IBM Plex Mono\", \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "features": { "numeric": "\"tnum\" 1, \"lnum\" 1", "mono": "\"liga\" 0" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "scale": {
      "xs":  { "size": 12, "lineHeight": 16, "tracking": 0 },
      "sm":  { "size": 13, "lineHeight": 18, "tracking": 0 },
      "base":{ "size": 14, "lineHeight": 20, "tracking": 0 },
      "md":  { "size": 16, "lineHeight": 24, "tracking": 0 },
      "lg":  { "size": 18, "lineHeight": 26, "tracking": -0.1 },
      "xl":  { "size": 22, "lineHeight": 30, "tracking": -0.2 },
      "2xl": { "size": 28, "lineHeight": 36, "tracking": -0.3 },
      "3xl": { "size": 36, "lineHeight": 44, "tracking": -0.5 }
    }
  },
  "radius": { "sm": 4, "md": 8, "lg": 12, "full": 9999 },
  "elevation": {
    "light": {
      "1": "0 1px 2px rgba(20, 20, 18, 0.08), 0 0 0 1px rgba(20, 20, 18, 0.04)",
      "2": "0 4px 12px rgba(20, 20, 18, 0.10), 0 1px 3px rgba(20, 20, 18, 0.06)",
      "3": "0 12px 32px rgba(20, 20, 18, 0.16), 0 2px 6px rgba(20, 20, 18, 0.08)"
    },
    "dark": {
      "1": "0 1px 2px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.06)",
      "2": "0 4px 12px rgba(0, 0, 0, 0.55), 0 1px 3px rgba(0, 0, 0, 0.4)",
      "3": "0 12px 32px rgba(0, 0, 0, 0.65), 0 2px 6px rgba(0, 0, 0, 0.4)"
    }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "emphasized": "cubic-bezier(0.3, 0, 0, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "zIndex": { "ribbon": 30, "rail": 20, "pane": 25, "tray": 40, "overlay": 50, "toast": 60 },
  "palette": {
    "light": {
      "bg": "#F6F6F3",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#EEEEEA",
      "border": "#D8D8D2",
      "borderStrong": "#AEAEA6",
      "text": "#1B1B1A",
      "textMuted": "#55554F",
      "textSubtle": "#66665F",
      "textInverse": "#FFFFFF",
      "accent": "#2456A6",
      "accentHover": "#1C468A",
      "accentSubtle": "#E3ECFA",
      "accentText": "#1E4C95",
      "onAccent": "#FFFFFF",
      "focus": "#2456A6",
      "selection": "#DCE7F8",
      "info": "#1F5FA8",
      "infoSubtle": "#E6F0FB",
      "success": "#1E7A46",
      "successSubtle": "#E3F3EA",
      "warning": "#7A5000",
      "warningSubtle": "#FBF0DA",
      "danger": "#B3261E",
      "dangerSubtle": "#FBE7E5",
      "chartGrid": "#E4E4DF",
      "chartAxis": "#8A8A83",
      "chartReference": "#55554F"
    },
    "dark": {
      "bg": "#141416",
      "surface": "#1C1C1F",
      "surfaceRaised": "#232327",
      "surfaceSunken": "#0F0F11",
      "border": "#34343B",
      "borderStrong": "#55555E",
      "text": "#ECECE9",
      "textMuted": "#B4B4AE",
      "textSubtle": "#A0A09A",
      "textInverse": "#141416",
      "accent": "#8DB4F3",
      "accentHover": "#A6C4F6",
      "accentSubtle": "#1D2A44",
      "accentText": "#A6C4F6",
      "onAccent": "#0B1A33",
      "focus": "#8DB4F3",
      "selection": "#24365A",
      "info": "#8DB4F3",
      "infoSubtle": "#1B2A44",
      "success": "#7BD3A0",
      "successSubtle": "#15301F",
      "warning": "#F2C14E",
      "warningSubtle": "#3A2C0A",
      "danger": "#F59A92",
      "dangerSubtle": "#3B1A18",
      "chartGrid": "#2C2C32",
      "chartAxis": "#8A8A90",
      "chartReference": "#B4B4AE"
    }
  },
  "semantic": {
    "sequential": {
      "score": {
        "description": "Case score 0 (worst) to 1 (best); light to deep teal.",
        "steps": ["#E9F4F1", "#C6E4DD", "#9DD1C6", "#6EBAAC", "#3F9E91", "#1F7F74", "#0B5F57"]
      },
      "violation": {
        "description": "Violation share or penalty 0 to 1; light to deep orange-red.",
        "steps": ["#FDF1E5", "#FADBBD", "#F5BE8E", "#EE9B60", "#E3743A", "#C8501F", "#9A3510"]
      }
    },
    "diverging": {
      "delta": {
        "description": "Change vs baseline or global; negative end red, neutral centre, positive end blue.",
        "steps": ["#B2182B", "#EF8A62", "#FDDBC7", "#EDEDE8", "#D1E5F0", "#67A9CF", "#2166AC"],
        "negative": "#B2182B",
        "neutral": "#EDEDE8",
        "positive": "#2166AC"
      }
    },
    "categorical": {
      "layers": {
        "description": "Okabe-Ito set; index by hashed layer id, max 8; each colour has a decal twin.",
        "colors": ["#0072B2", "#E69F00", "#009E73", "#CC79A7", "#56B4E9", "#D55E00", "#F0E442", "#8C8C8C"],
        "decals": ["none", "diagonal", "dots", "cross", "horizontal", "vertical", "grid", "wave"]
      }
    },
    "kind": {
      "description": "Kinds of problem, the plain labels of the panel report; `hotspot` below holds the method's names as aliases.",
      "acute":      { "glyph": "▲", "label": "acute",      "reading": "few cases, far off",       "method": "severity",  "light": { "fg": "#9C3B0A", "bg": "#FBE9DF", "solid": "#C8501F" }, "dark": { "fg": "#F4A57F", "bg": "#3E2213", "solid": "#E3743A" } },
      "systematic": { "glyph": "◆", "label": "systematic", "reading": "one pattern behind it",    "method": "mechanism", "light": { "fg": "#6E3596", "bg": "#F1E7F8", "solid": "#8A4DB5" }, "dark": { "fg": "#D3ADEC", "bg": "#2E1D3D", "solid": "#B07CD6" } },
      "widespread": { "glyph": "●", "label": "widespread", "reading": "many cases, slightly off", "method": "reservoir", "light": { "fg": "#1E4C95", "bg": "#E3ECFA", "solid": "#2456A6" }, "dark": { "fg": "#A6C4F6", "bg": "#1B2A44", "solid": "#8DB4F3" } }
    },
    "hotspot": {
      "description": "Aliases: the method's hotspot types map onto the kinds above (severity → acute, mechanism → systematic, reservoir → widespread).",
      "severity":  { "glyph": "▲", "label": "severity",  "kind": "acute",      "light": { "fg": "#9C3B0A", "bg": "#FBE9DF", "solid": "#C8501F" }, "dark": { "fg": "#F4A57F", "bg": "#3E2213", "solid": "#E3743A" } },
      "mechanism": { "glyph": "◆", "label": "mechanism", "kind": "systematic", "light": { "fg": "#6E3596", "bg": "#F1E7F8", "solid": "#8A4DB5" }, "dark": { "fg": "#D3ADEC", "bg": "#2E1D3D", "solid": "#B07CD6" } },
      "reservoir": { "glyph": "●", "label": "reservoir", "kind": "widespread", "light": { "fg": "#1E4C95", "bg": "#E3ECFA", "solid": "#2456A6" }, "dark": { "fg": "#A6C4F6", "bg": "#1B2A44", "solid": "#8DB4F3" } }
    },
    "gate": {
      "pending": { "glyph": "○", "label": "pending", "light": { "fg": "#55554F", "bg": "#EDEDE9" }, "dark": { "fg": "#B4B4AE", "bg": "#2A2A2E" } },
      "passed":  { "glyph": "✓", "label": "passed",  "light": { "fg": "#1E7A46", "bg": "#E3F3EA" }, "dark": { "fg": "#7BD3A0", "bg": "#15301F" } },
      "failed":  { "glyph": "✕", "label": "failed",  "light": { "fg": "#B3261E", "bg": "#FBE7E5" }, "dark": { "fg": "#F59A92", "bg": "#3B1A18" } },
      "waived":  { "glyph": "⊘", "label": "waived",  "light": { "fg": "#7A5000", "bg": "#FBF0DA" }, "dark": { "fg": "#F2C14E", "bg": "#3A2C0A" } }
    },
    "stability": {
      "description": "Confidence in the rank (plain `confidence`), keyed by the method's stability names.",
      "stable":   { "glyph": "●●●", "label": "stable",   "confidence": "high confidence in the rank",  "light": "#1E7A46", "dark": "#7BD3A0" },
      "fragile":  { "glyph": "●●○", "label": "fragile",     "confidence": "medium confidence",          "light": "#7A5000", "dark": "#F2C14E" },
      "insufficient_support": { "glyph": "●○○", "label": "insufficient support", "confidence": "not enough cases to be sure", "light": "#B3261E", "dark": "#F59A92" },
      "unknown":  { "glyph": "○○○", "label": "unknown",  "confidence": "not computed",                 "light": "#66665F", "dark": "#A0A09A" }
    },
    "stage": {
      "not_started": { "glyph": "○", "label": "not started" },
      "in_progress": { "glyph": "◐", "label": "in progress" },
      "gated":       { "glyph": "⊘", "label": "gated" },
      "done":        { "glyph": "●", "label": "done" }
    }
  }
}
