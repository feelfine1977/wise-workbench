{
  "$schema": "./tokens.schema.json",
  "name": "wise-workbench",
  "version": "0.3.0",
  "spacing": {
    "unit": 4,
    "scale": {
      "0": 0,
      "px": 1,
      "0.5": 2,
      "1": 4,
      "1.5": 6,
      "2": 8,
      "2.5": 10,
      "3": 12,
      "3.5": 14,
      "4": 16,
      "5": 20,
      "6": 24,
      "7": 28,
      "8": 32,
      "9": 36,
      "10": 40,
      "11": 44,
      "12": 48,
      "14": 56,
      "16": 64,
      "20": 80,
      "24": 96,
      "28": 112,
      "32": 128,
      "36": 144,
      "40": 160,
      "48": 192,
      "52": 208,
      "72": 288,
      "80": 320,
      "96": 384
    }
  },
  "density": {
    "comfortable": {
      "rowHeight": 40,
      "controlHeight": 36,
      "cellPaddingX": 12,
      "cardPadding": 20,
      "cardGap": 16
    },
    "compact": {
      "rowHeight": 30,
      "controlHeight": 32,
      "cellPaddingX": 8,
      "cardPadding": 12,
      "cardGap": 8
    }
  },
  "typography": {
    "family": {
      "ui": "\"Inter\", \"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "mono": "\"IBM Plex Mono\", \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "features": {
      "numeric": "\"tnum\" 1, \"lnum\" 1",
      "mono": "\"liga\" 0"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "scale": {
      "xs": {
        "size": 12,
        "lineHeight": 16,
        "tracking": 0
      },
      "sm": {
        "size": 13,
        "lineHeight": 18,
        "tracking": 0
      },
      "base": {
        "size": 15,
        "lineHeight": 22,
        "tracking": 0
      },
      "md": {
        "size": 16,
        "lineHeight": 24,
        "tracking": 0
      },
      "lg": {
        "size": 20,
        "lineHeight": 26,
        "tracking": -0.1
      },
      "xl": {
        "size": 24,
        "lineHeight": 32,
        "tracking": -0.2
      },
      "2xl": {
        "size": 30,
        "lineHeight": 38,
        "tracking": -0.3
      },
      "3xl": {
        "size": 36,
        "lineHeight": 44,
        "tracking": -0.5
      }
    },
    "measure": {
      "reading": "68ch",
      "card": "80ch"
    }
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 8,
    "full": 9999
  },
  "elevation": {
    "light": {
      "1": "none",
      "2": "0 8px 24px rgba(15, 36, 71, 0.12)",
      "3": "0 8px 24px rgba(15, 36, 71, 0.18)"
    },
    "dark": {
      "1": "none",
      "2": "0 4px 12px rgba(0, 0, 0, 0.55), 0 1px 3px rgba(0, 0, 0, 0.4)",
      "3": "0 12px 32px rgba(0, 0, 0, 0.65), 0 2px 6px rgba(0, 0, 0, 0.4)"
    }
  },
  "motion": {
    "duration": {
      "fast": 150,
      "base": 220,
      "slow": 250
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "zIndex": {
    "ribbon": 30,
    "rail": 20,
    "pane": 25,
    "tray": 40,
    "overlay": 50,
    "toast": 60
  },
