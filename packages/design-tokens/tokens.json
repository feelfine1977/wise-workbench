          "#EDF3FD",
          "#D5E3FA",
          "#B2CBF3",
          "#87ACE9",
          "#5B8AE0",
          "#3468D3",
          "#1E4FC4"
        ]
      }
    },
    "diverging": {
      "delta": {
        "description": "Signed score contributions: copper shortfall, teal offset, neutral centre.",
