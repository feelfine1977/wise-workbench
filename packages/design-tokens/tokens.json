  "semantic": {
    "sequential": {
      "score": {
        "description": "Case score 0 (worst) to 1 (best); light to deep teal.",
        "steps": [
          "#EAF6F3",
          "#C7EAE2",
          "#9FD9CC",
          "#6FC2B2",
          "#42A694",
          "#1F8574",
          "#0B6356"
        ]
      },
      "violation": {
        "description": "Compatibility alias of penalty; kept for existing chart consumers.",
        "steps": [
          "#FDF3EC",
          "#F8DFCB",
          "#F0C4A2",
          "#E4A273",
          "#D07E48",
          "#B15E28",
          "#8A4312"
        ]
      },
      "penalty": {
        "description": "Bounded penalty 0 to 1; sequential copper. A penalty is not a status or a stakeholder identity.",
        "steps": [
          "#FDF3EC",
          "#F8DFCB",
          "#F0C4A2",
          "#E4A273",
          "#D07E48",
          "#B15E28",
          "#8A4312"
        ]
      },
      "count": {
        "description": "Case count; blue is reserved for the selected population.",
