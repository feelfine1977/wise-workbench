{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-workbench.local/schema/templates.schema.json",
  "title": "Index of norm templates shipped with a pack",
  "type": "object",
  "required": [
    "pack",
    "version",
    "review_status",
    "templates"
  ],
  "properties": {
    "pack": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "review_status": {
      "$ref": "common.schema.json#/$defs/reviewStatus"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "string"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "name",
          "description",
          "calibration",
          "activity_labels",
          "evidence",
          "review_status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "file": {
            "type": "string",
            "pattern": "\\.json$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "calibration": {
            "type": "string",
            "enum": [
              "calibrated",
              "uncalibrated",
              "mixed"
            ]
          },
          "activity_labels": {
            "type": "string",
            "enum": [
              "log_labels",
              "canonical_ids"
            ],
            "description": "Whether activity parameters are raw log labels of one dataset or canonical ids to be translated through the activity mapping."
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/evidence"
          },
          "dataset": {
            "type": "string"
          },
          "verbatim": {
            "type": "boolean",
            "description": "A byte-identical copy of an external file (the paper's norm); never rewritten, guidance is served from guidance.yaml only."
          },
          "derived_from": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "Template this draft was derived from; the differences are listed in the template's metadata.meta.changes."
          },
          "flow_type_attribute": {
            "type": "string"
          },
          "flow_types": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "sources": {
            "$ref": "common.schema.json#/$defs/sources"
          },
          "review_status": {
            "$ref": "common.schema.json#/$defs/reviewStatus"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
