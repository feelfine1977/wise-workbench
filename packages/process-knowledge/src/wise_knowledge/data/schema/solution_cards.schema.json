{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-pm.org/schema/solution_cards.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "blocks",
    "cards"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "blocks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "question",
          "requires",
          "calculation",
          "presentation",
          "missingData",
          "interpretation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "calculation": {
            "type": "string",
            "minLength": 1
          },
          "missingData": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "activity_coverage",
              "endpoint_duration",
              "end_day_of_month",
              "due_date_lead"
            ]
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "presentation": {
            "enum": [
              "coverage",
              "summary",
              "day_bars",
              "availability"
            ]
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "title",
          "intent",
          "match",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "types"
            ],
            "properties": {
              "types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "processes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constraintIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
