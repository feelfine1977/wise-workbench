{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-workbench.local/schema/kpis.schema.json",
  "title": "KPI definitions in WISE terms",
  "type": "object",
  "required": ["pack", "version", "review_status", "kpis"],
  "properties": {
    "pack": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "review_status": { "$ref": "common.schema.json#/$defs/reviewStatus" },
    "sources": { "$ref": "common.schema.json#/$defs/sources" },
    "notes": { "type": "string" },
    "kpis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "name", "definition", "unit", "direction", "review_status"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "version": { "$ref": "common.schema.json#/$defs/version" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "definition": { "$ref": "common.schema.json#/$defs/text" },
          "formula": { "type": "string", "description": "Formula in WISE terms (constraint types, violation shares, lags) where one exists." },
          "unit": { "type": "string", "minLength": 1 },
          "direction": { "type": "string", "enum": ["lower_is_better", "higher_is_better", "target"] },
          "stage": { "$ref": "common.schema.json#/$defs/id" },
          "activities": { "$ref": "common.schema.json#/$defs/idList" },
          "failure_modes": { "$ref": "common.schema.json#/$defs/idList" },
          "wise_expressible": { "type": "boolean", "description": "Whether the KPI can be read directly off WISE constraints." },
          "sources": { "$ref": "common.schema.json#/$defs/sources" },
          "review_status": { "$ref": "common.schema.json#/$defs/reviewStatus" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
