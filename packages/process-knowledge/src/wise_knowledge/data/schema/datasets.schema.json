{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-workbench.local/schema/datasets.schema.json",
  "title": "Registry of public event logs used for packs, presets and evaluation",
  "type": "object",
  "required": ["version", "datasets"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "licence_default": { "type": "string" },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "countOrList": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string" },
        { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      ]
    },
    "dataset": {
      "type": "object",
      "required": ["id", "title", "pack"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 1 },
        "doi": { "type": ["string", "null"] },
        "licence": { "type": "string" },
        "pack": { "type": "string", "minLength": 1 },
        "variant": { "type": "string" },
        "process": { "type": "string" },
        "organisation": { "type": "string" },
        "formats": { "type": "array", "items": { "type": "string" } },
        "cases": { "$ref": "#/$defs/countOrList" },
        "events": { "$ref": "#/$defs/countOrList" },
        "activities": { "$ref": "#/$defs/countOrList" },
        "offers": { "type": "integer" },
        "document_types": { "type": "integer" },
        "period": { "type": "string" },
        "case_notion": { "type": "string" },
        "exposure": { "type": "string" },
        "slice_keys": { "type": "array", "items": { "type": "string" } },
        "pitfalls": { "type": "array", "items": { "type": "string" } },
        "preset": { "type": "string" },
        "reference_norm": { "type": "string" },
        "role": { "type": "string" },
        "usage": { "type": "string" },
        "local_only": { "type": "boolean" },
        "pack_draft": { "type": "string" },
        "approx": { "type": "boolean" },
        "checked": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["date"],
              "properties": {
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
